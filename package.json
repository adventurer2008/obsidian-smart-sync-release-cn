{
  "name": "obsidian-smart-client",
  "version": "1.1.13",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/community-build.mjs",
    "build:cn": "node scripts/build.mjs --edition=cn",
    "build:global": "node scripts/build.mjs --edition=global",
    "build:word": "node scripts/build.mjs --edition=word",
    "build:all": "node scripts/build.mjs --all",
    "check:isolation": "node scripts/check-isolation.mjs",
    "check:editions": "node scripts/check-isolation.mjs cn && node scripts/check-isolation.mjs global && node scripts/check-isolation.mjs word",
    "check:community": "node tools/community-lint/run.mjs cn"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "esbuild": "0.28.1",
    "jsdom": "26.1.0",
    "rrweb-cssom": "0.8.0"
  },
  "dependencies": {
    "@codemirror/commands": "6.8.1",
    "@eigenpal/docx-editor-core": "1.9.0",
    "@eigenpal/docx-editor-i18n": "1.9.0",
    "@eigenpal/docx-editor-react": "1.9.0",
    "@lezer/common": "1.5.0",
    "@lezer/markdown": "1.8.1",
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.0.1",
    "cfb": "1.2.2",
    "fflate": "0.8.3",
    "node-diff3": "3.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "description": "Shared Client source for Wujie Sync and Smart Sync regional builds.",
  "repository": {
    "type": "git",
    "url": "https://github.com/adventurer2008/obsidian-smart-sync-client.git"
  }
}
